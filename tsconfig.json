{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",

    "rootDir": ".",
    "outDir": "./dist",

    "strict": true,

    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,

    "types": [
      "node",
      "jest"
    ]
  },

  "include": [
    "src/**/*",
    "focus/**/*"
  ],

  "exclude": [
    "node_modules",
    "dist"
  ]
}